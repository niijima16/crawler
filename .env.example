# docker compose の設定例。`.env` にコピーして使う（.env はコミットしない）。

# 資格情報（サイトのパスワード）を暗号化する鍵。ローカルでは空のままでよい。
# 空なら、初回の起動時に自動で作られ、Docker のボリューム（docker compose down -v で消える）に保存される。
# 自分で指定するときは、次のコマンドで作る（AWS などでは必ず指定する）:
#   openssl rand -base64 32 | tr '+/' '-_'
# 指定した鍵を失くしたり変えたりすると、保存済みのアカウントは復号できない（再登録すれば復旧できる）。
CREDENTIALS_KEY=

# 同時セッション数（既定3・上限5）と、確認画面までの制限時間（既定60秒・上限120秒）
PREVIEW_PARALLELISM=3
PREVIEW_DEADLINE_SECONDS=60
# 1分ごとの監視で購入するときの制限時間（既定20秒）
TICK_DEADLINE_SECONDS=20

# 注文確定を許可するときだけ true にする（既定 false）。自動購入にも必要。
ALLOW_ORDER_SUBMIT=false
